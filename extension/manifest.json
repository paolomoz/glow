{
  "manifest_version": 3,
  "name": "Glow — Generative Layer Over Web",
  "description": "Real-time generative personalization overlay for any website",
  "version": "0.1.0",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-script/index.js"],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "panel/panel.html"
  },
  "action": {
    "default_title": "Glow",
    "default_icon": {
      "16": "icons/glow-16.png",
      "32": "icons/glow-32.png",
      "48": "icons/glow-48.png",
      "128": "icons/glow-128.png"
    }
  },
  "icons": {
    "16": "icons/glow-16.png",
    "32": "icons/glow-32.png",
    "48": "icons/glow-48.png",
    "128": "icons/glow-128.png"
  }
}
