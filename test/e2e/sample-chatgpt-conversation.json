          "create_time": 1700000300,
          "content": {
            "content_type": "text",
            "parts": ["For a team of 50 with SOC2 and SSO requirements, the Enterprise plan is the clear choice. Those security features are only available on Enterprise."]
          }
        },
        "parent": "msg-4",
        "children": ["msg-6"]
      },
      "msg-6": {
        "id": "msg-6",
        "message": {
          "id": "msg-6",
          "author": { "role": "user" },
          "create_time": 1700000360,
          "content": {
            "content_type": "text",
            "parts": ["Great, I want to sign up for the Enterprise trial. How do I get started?"]
